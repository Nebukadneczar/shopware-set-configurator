<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/shopware/shopware/trunk/src/Core/System/SystemConfig/Schema/config.xsd">
    <card>
        <title>Appearance</title>
        <title lang="de-DE">Darstellung</title>

        <input-field type="colorpicker">
            <name>primaryColor</name>
            <label>Accent color</label>
            <label lang="de-DE">Akzentfarbe</label>
            <helpText>Used for headings, prices and highlights of the configurator in the storefront.</helpText>
            <helpText lang="de-DE">Für Überschriften, Preise und Hervorhebungen des Konfigurators im Shop.</helpText>
            <defaultValue>#0b5ed7</defaultValue>
        </input-field>

        <input-field type="colorpicker">
            <name>borderColor</name>
            <label>Border color</label>
            <label lang="de-DE">Rahmenfarbe</label>
            <defaultValue>#d7dde3</defaultValue>
        </input-field>
    </card>
</config>
